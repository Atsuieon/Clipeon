{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipeon",
  "mainBinaryName": "Clipeon",
  "version": "1.5.0",
  "identifier": "pl.clipper.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRDk0MjYwRTkyQUY5RkIKUldUNytTcnBZRUxadWlhS2hwT2ZXZE4xR2d6bDZGeGdJb0NmSnlUa3d3Y3FJZ1IrOWNoOXAzVkgK",
      "endpoints": [
        "https://github.com/Atsuieon/Clipeon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Atsuieon",
    "copyright": "© 2026 Atsuieon",
    "category": "Video",
    "shortDescription": "Lekkie nagrywanie powtórek z gier",
    "longDescription": "Clipeon nagrywa w tle ostatnie sekundy gry i zapisuje je jako klip jednym skrótem.",
    "homepage": "https://github.com/Atsuieon/Clipeon",
    "licenseFile": "instalator/licencja.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "LICENSE": "LICENSE.txt",
      "THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "instalator/hooks.nsh",
        "startMenuFolder": "Clipeon",
        "customLanguageFiles": {
          "Polish": "instalator/Polish.nsh"
        }
      }
    }
  }
}